# Credentials live OUTSIDE the repository so that a stray `git add -f`,
# a `zip -r` of the project folder, or a shared directory cannot leak them.
#
# Install:
#   mkdir -p ~/.config/wheelscan && chmod 700 ~/.config/wheelscan
#   cp .env.example ~/.config/wheelscan/.env
#   chmod 600 ~/.config/wheelscan/.env
#   # then edit that file and paste your keys
#
# Searched in order:
#   1. $WHEELSCAN_ENV                  (explicit override)
#   2. ~/.config/wheelscan/.env        (preferred)
#   3. <repo>/.env                     (legacy, still works)
#
# Real environment variables always win over any file.

ALPACA_API_KEY_ID=your_key_here
ALPACA_API_SECRET_KEY=your_secret_here
